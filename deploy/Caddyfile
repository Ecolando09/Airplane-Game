# Site block for /etc/caddy/Caddyfile: the games homepage, the games under it,
# and /ws passed to the phone-controller relay. Caddy handles HTTPS on its own.
play.latlas.lol {
    encode gzip
    handle /ws {
        reverse_proxy localhost:8787
    }
    handle {
        root * /var/www/play
        file_server
    }
}
